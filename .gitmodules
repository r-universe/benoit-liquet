[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "MBSGS"]
	path = MBSGS
	url = https://github.com/cran/MBSGS
[submodule "combss"]
	path = combss
	url = https://github.com/benoit-liquet/combss
[submodule "sgPLS"]
	path = sgPLS
	url = https://github.com/cran/sgPLS
